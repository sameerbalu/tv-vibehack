<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn over every tile: a soft sheen from the top edge, and a touch of shade at the bottom (the rim light is RimLight, drawn in code), so the tile looks like glass lit from above. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1CFFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.38" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#26000000"
                android:endColor="#00000000"
                android:centerY="0.45" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
