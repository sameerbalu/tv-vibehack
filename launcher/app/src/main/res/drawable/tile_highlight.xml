<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn over every tile: a soft sheen from the top edge, a thin bright rim along the top, a fine border,
     and a touch of shade at the bottom, so the tile looks like glass lit from above. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1CFFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.38" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#26000000"
                android:endColor="#00000000"
                android:centerY="0.45" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:height="1.5dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1CFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
