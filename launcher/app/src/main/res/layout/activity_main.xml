<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.82"
        android:visibility="gone"
        android:contentDescription="@null" />
    <!-- Blurred copy of the wallpaper; fades in while the full app grid is showing. -->
    <ImageView
        android:id="@+id/wallpaperBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:visibility="gone"
        android:contentDescription="@null" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55000000"
        android:importantForAccessibility="no" />
    <!-- Extra dimming while the full app grid is showing (also works with no wallpaper). -->
    <View
        android:id="@+id/allAppsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:alpha="0"
        android:importantForAccessibility="no" />


    <!-- Ambient glow in the colour of the focused dock app (dock state only). -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Spotify lyrics: under the depth PNG, so the "character" of the wallpaper stands in front of the words. -->
    <com.gathin.tvhome.LyricsView
        android:id="@+id/lyricsView"
        android:layout_width="400dp"
        android:layout_height="160dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="50sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 700"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <!-- Depth effect: a transparent PNG over the glow (the glow is behind the "character"). -->
    <ImageView
        android:id="@+id/wallpaperFront"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Frosted-glass panel behind the all-apps list (all-apps state only). Top margin is set in code. -->
    <com.gathin.tvhome.GlassPanelView
        android:id="@+id/allAppsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="208dp"
        android:layout_marginBottom="24dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Full-screen grid: the dock row is parked at the bottom in code; the rest scrolls in from below. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="10dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

    <!-- Widget cards on the right; positioned above the dock in code. -->
    <com.gathin.tvhome.WidgetPanel
        android:id="@+id/widgets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginEnd="56dp"
        android:importantForAccessibility="no" />

    <!-- Widget cards on the left; positioned above the dock app's name in code. -->
    <com.gathin.tvhome.WidgetPanel
        android:id="@+id/widgetsLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="56dp"
        android:importantForAccessibility="no" />

    <!-- Clock, date and top buttons. Fades out while the full app list (or arrange mode) is showing. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <com.gathin.tvhome.GlassClockView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:id="@+id/clockDivider"
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:format12Hour="@string/date_format"
                        android:format24Hour="@string/date_format"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnBluetooth"
                    style="@style/TopButton"
                    android:text="@string/bluetooth"
                    android:drawableStart="@drawable/ic_bluetooth"
                    android:nextFocusDown="@+id/grid" />

                <ImageView
                    android:id="@+id/btnSettings"
                    style="@style/TopIcon"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

    <!-- Second copy of the depth PNG, clipped (in code) to the clock + date block so they sit behind it. -->
    <ImageView
        android:id="@+id/wallpaperFrontTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
