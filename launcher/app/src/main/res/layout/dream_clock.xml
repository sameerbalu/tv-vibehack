<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream and the preview): your wallpaper as the background (the aurora if none is set),
     a red and white clock in the top-left corner (behind the depth PNG when one is set) and a Spotify scene. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.gathin.tvhome.AuroraView
        android:id="@+id/saverAurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/saverWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <View
        android:id="@+id/saverScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/saver_scrim" />

    <LinearLayout
        android:id="@+id/saverContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="52dp"
        android:layout_marginTop="36dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/saverGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#FFB3121B"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.28"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:"
                android:format24Hour="HH:"
                android:textColor="#FFFFFFFF"
                android:textSize="120sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 450"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:textColor="#FFB3121B"
                android:textSize="120sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 450"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#FFB3121B"
                android:textSize="24sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:format12Hour="EEEE  d MMMM"
            android:format24Hour="EEEE  d MMMM"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />

    </LinearLayout>

    <!-- Depth foreground (transparent PNG), over the picture AND over the clock / date. -->
    <ImageView
        android:id="@+id/saverFront"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Spotify scene (above the PNG so the song is always readable): glow, album art, song, progress. -->
    <View
        android:id="@+id/saverMusicGlow"
        android:layout_width="720dp"
        android:layout_height="460dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-120dp"
        android:layout_marginBottom="-140dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/saverNowRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/saverNowArt"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.gathin.tvhome.EqView
                    android:id="@+id/saverNowEq"
                    android:layout_width="22dp"
                    android:layout_height="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Now playing on Spotify"
                    android:textColor="#FFB3121B"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit"
                    android:letterSpacing="0.2"
                    android:textAllCaps="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/saverNowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxWidth="520dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600" />

            <TextView
                android:id="@+id/saverNowArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="520dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/outfit" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.gathin.tvhome.ColorBar
                    android:id="@+id/saverNowBar"
                    android:layout_width="300dp"
                    android:layout_height="4dp" />

                <TextView
                    android:id="@+id/saverNowTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

